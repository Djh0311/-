{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"/opt/homebrew/Cellar/node/23.11.0/bin/node\" \"$DEVIN_PROJECT_DIR/.devin/hooks/harness-lite.cjs\"",
          "timeout": 15
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"/opt/homebrew/Cellar/node/23.11.0/bin/node\" \"$DEVIN_PROJECT_DIR/.devin/hooks/harness-lite.cjs\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(exec|functions\\.exec|Bash)$",
      "hooks": [
        {
          "type": "command",
          "command": "\"/opt/homebrew/Cellar/node/23.11.0/bin/node\" \"$DEVIN_PROJECT_DIR/.devin/hooks/harness-lite.cjs\"",
          "timeout": 10
        }
      ]
    }
  ]
}
