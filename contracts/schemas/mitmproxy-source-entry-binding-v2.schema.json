{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mitmproxy-source-entry-binding-v2.schema.json",
  "title": "Closed passive source entry for a current target declaration",
  "description": "Current dispatch target attestation only; no historical target, source locator or business values. It does not prove source identity, readiness or confer transport permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_target_ref",
    "target_binding_ref",
    "source_entry_ref",
    "source_entry_kind",
    "route_id",
    "source_kind",
    "source_purpose",
    "network_capability",
    "forbidden_capabilities",
    "output_root_ref",
    "output_root_mode",
    "live_capture_latch",
    "execution_latch",
    "source_attempts_consumed",
    "automatic_retry",
    "source_material_persisted",
    "business_publication_allowed",
    "target_confirmation_ref",
    "target_confirmation_status",
    "source_identity_status",
    "fresh_factory"
  ],
  "properties": {
    "schema_version": {
      "const": "collection-mitmproxy-source-entry-binding/v2"
    },
    "runtime_target_ref": {
      "type": "string",
      "pattern": "^target:[A-Za-z0-9_-]{8,96}$"
    },
    "target_binding_ref": {
      "type": "string",
      "pattern": "^target-binding:[A-Za-z0-9_-]{8,96}$"
    },
    "source_entry_ref": {
      "type": "string",
      "pattern": "^source-entry:[A-Za-z0-9_-]{8,96}$"
    },
    "source_entry_kind": {
      "const": "MITMPROXY_PASSIVE_CALLBACK"
    },
    "route_id": {
      "const": "OWNED_STRUCTURED_EVENT"
    },
    "source_kind": {
      "const": "SEPARATELY_AUTHORIZED_STRUCTURED_SOURCE"
    },
    "source_purpose": {
      "const": "SEPARATELY_AUTHORIZED_STRUCTURED_SOURCE_P0_VALIDATION"
    },
    "network_capability": {
      "const": "SINGLE_NETWORK_SOURCE_READ"
    },
    "forbidden_capabilities": {
      "const": [
        "BROWSER_UI",
        "WECHAT_UI",
        "SYSTEM_PROXY",
        "CA_INSTALL_OR_USE",
        "KEYCHAIN",
        "CREDENTIAL_ACCESS",
        "SESSION_ACCESS",
        "TRANSACTION"
      ]
    },
    "output_root_ref": {
      "type": "string",
      "pattern": "^output-root:[A-Za-z0-9_-]{8,96}$"
    },
    "output_root_mode": {
      "const": "0700"
    },
    "live_capture_latch": {
      "const": "CLOSED"
    },
    "execution_latch": {
      "const": "CLOSED"
    },
    "source_attempts_consumed": {
      "const": 0
    },
    "automatic_retry": {
      "const": false
    },
    "source_material_persisted": {
      "const": false
    },
    "business_publication_allowed": {
      "const": false
    },
    "fresh_factory": {
      "const": "IMMEDIATE_FRESH_REQUEST_ONLY"
    },
    "target_confirmation_ref": {
      "type": "string",
      "pattern": "^target-confirmation:[A-Za-z0-9_-]{8,96}$"
    },
    "target_confirmation_status": {
      "const": "CALLER_ATTESTED_CURRENT_CHOICE"
    },
    "source_identity_status": {
      "const": "NOT_OBSERVED"
    }
  },
  "$comment": "Transport or certificate permissions belong to a separately confirmed capability scope. This passive adapter never grants them. Actual source matching must still use current facts."
}
