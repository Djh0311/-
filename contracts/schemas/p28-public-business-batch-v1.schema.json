{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P28 current public business scalar batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_ref",
    "source_association",
    "coverage",
    "field_meanings",
    "observations",
    "sensitive_values_processed",
    "raw_payload_persisted"
  ],
  "properties": {
    "schema_version": {
      "const": "p28-public-business-batch/v1"
    },
    "window_ref": {
      "type": "string",
      "pattern": "^result:[a-f0-9]{32}$"
    },
    "source_association": {
      "$ref": "p26-result-association-check-v1.schema.json"
    },
    "coverage": {
      "const": "CURRENT_RESPONSES_ONLY"
    },
    "field_meanings": {
      "const": "DEVELOPER_REVIEW_REQUIRED"
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "source_request_ref",
          "observed_at",
          "fields",
          "public_values",
          "unavailable_fields",
          "restricted_fields",
          "sensitive_rejections",
          "field_meanings",
          "sensitive_values_processed",
          "raw_payload_persisted"
        ],
        "properties": {
          "endpoint_id": {
            "enum": [
              "FOOD",
              "PRODUCTLIST"
            ]
          },
          "source_request_ref": {
            "type": "string",
            "pattern": "^request:[a-f0-9]{32}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "fields": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "type": {
                  "enum": [
                    "object",
                    "array",
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "public_values": {
            "type": "array",
            "maxItems": 8000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "coordinates",
                "value"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 39999
                      }
                    ]
                  }
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 256
                }
              }
            }
          },
          "unavailable_fields": {
            "type": "array",
            "maxItems": 8000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "type",
                "reason"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "type": {
                  "enum": [
                    "object",
                    "array",
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "reason": {
                  "enum": [
                    "NONSCALAR",
                    "STRING_LENGTH",
                    "URL_VALUE",
                    "LINE_BREAK",
                    "NONFINITE_NUMBER"
                  ]
                }
              }
            }
          },
          "restricted_fields": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "type",
                "category"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "type": {
                  "enum": [
                    "object",
                    "array",
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "category": {
                  "enum": [
                    "CREDENTIAL_KEY",
                    "SESSION_KEY",
                    "PERSONAL_KEY",
                    "TRANSPORT_KEY",
                    "UNCLASSIFIED_KEY"
                  ]
                }
              }
            }
          },
          "sensitive_rejections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "CREDENTIAL_KEY",
              "SESSION_KEY",
              "PERSONAL_KEY",
              "TRANSPORT_KEY",
              "UNCLASSIFIED_KEY"
            ],
            "properties": {
              "CREDENTIAL_KEY": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "SESSION_KEY": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "PERSONAL_KEY": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "TRANSPORT_KEY": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "UNCLASSIFIED_KEY": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            }
          },
          "field_meanings": {
            "const": "DEVELOPER_REVIEW_REQUIRED"
          },
          "sensitive_values_processed": {
            "const": false
          },
          "raw_payload_persisted": {
            "const": false
          }
        }
      }
    },
    "sensitive_values_processed": {
      "const": false
    },
    "raw_payload_persisted": {
      "const": false
    }
  }
}
