{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p28-price-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis",
    "evidence_ref",
    "currency",
    "amount_unit"
  ],
  "properties": {
    "schema_version": {
      "const": "p28-price-evidence/v1"
    },
    "basis": {
      "enum": [
        "SYNTHETIC_RULE_TEST",
        "USER_CONFIRMED_MULTI_SKU_PAGE"
      ]
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^evidence:[A-Za-z0-9_-]{8,96}$"
    },
    "currency": {
      "const": "CNY"
    },
    "amount_unit": {
      "const": "YUAN"
    }
  }
}
