{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p28-binding-batch-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload_family",
    "payload_version",
    "coverage_status",
    "coverage_scope",
    "p0_result",
    "price_evidence",
    "sku_inventory",
    "sku_records"
  ],
  "properties": {
    "schema_version": {
      "const": "collection-p28-binding-batch/v1"
    },
    "payload_family": {
      "const": "meituan_wechat_miniprogram"
    },
    "payload_version": {
      "const": "p28-observed-shop-sku-v1"
    },
    "coverage_status": {
      "const": "PARTIAL"
    },
    "coverage_scope": {
      "const": "CURRENT_LIST_RESPONSE_ONLY"
    },
    "p0_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_batch",
        "field_observations",
        "business_records"
      ],
      "properties": {
        "observation_batch": {
          "$ref": "observation-batch.schema.json"
        },
        "field_observations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 65536,
          "items": {
            "$ref": "field-observation-v2.schema.json"
          }
        },
        "business_records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": {
            "$ref": "business-record-v2.schema.json"
          }
        }
      }
    },
    "price_evidence": {
      "$ref": "p28-price-evidence-v1.schema.json"
    },
    "sku_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "p0_business_record_ref",
          "sku_ids"
        ],
        "properties": {
          "p0_business_record_ref": {
            "type": "string",
            "pattern": "^business-record:[A-Za-z0-9_-]{8,96}$"
          },
          "sku_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        }
      }
    },
    "sku_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40000,
      "items": {
        "$ref": "p28-sku-record-v1.schema.json"
      }
    }
  },
  "$comment": "Semantic validation additionally checks same-observation P0 bindings, complete SKU membership, owners, category copies, minimum prices and the evidence basis against source_kind. Synthetic validation never establishes live source readiness."
}
