{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-p0-entry-stop-v1.schema.json",
  "title": "Closed P17 stop before a new controlled source entry exists",
  "description": "Value-free conclusion that the historically bound target has no new controllable source reader or runtime lock. It is not a source attempt and cannot authorize one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stop_code",
    "historical_target_ref",
    "historical_target_status",
    "runtime_target_binding",
    "route_id",
    "source_kind",
    "source_purpose",
    "network_capability",
    "forbidden_capabilities",
    "live_capture_latch",
    "execution_latch",
    "source_attempts_consumed",
    "automatic_retry",
    "source_material_persisted",
    "business_publication_allowed"
  ],
  "properties": {
    "schema_version": {"const": "collection-live-p0-entry-stop/v1"},
    "stop_code": {"const": "LIVE_SOURCE_ENTRY_UNAVAILABLE"},
    "historical_target_ref": {"const": "TGT-HZ-XCJ-GFTJ-001"},
    "historical_target_status": {"const": "NOT_OBSERVED"},
    "runtime_target_binding": {"const": "NOT_BOUND"},
    "route_id": {"const": "OWNED_STRUCTURED_EVENT"},
    "source_kind": {"const": "SEPARATELY_AUTHORIZED_STRUCTURED_SOURCE"},
    "source_purpose": {"const": "SEPARATELY_AUTHORIZED_STRUCTURED_SOURCE_P0_VALIDATION"},
    "network_capability": {"const": "SINGLE_NETWORK_SOURCE_READ"},
    "forbidden_capabilities": {"const": ["BROWSER_UI", "WECHAT_UI", "SYSTEM_PROXY", "CA_INSTALL_OR_USE", "KEYCHAIN", "CREDENTIAL_ACCESS", "SESSION_ACCESS", "TRANSACTION"]},
    "live_capture_latch": {"const": "CLOSED"},
    "execution_latch": {"const": "CLOSED"},
    "source_attempts_consumed": {"const": 0},
    "automatic_retry": {"const": false},
    "source_material_persisted": {"const": false},
    "business_publication_allowed": {"const": false}
  },
  "$comment": "A later source entry must use a new P15 request and a new runtime target-binding object. Historical locks, authorization, candidate profiles and family/version cannot be reused."
}
