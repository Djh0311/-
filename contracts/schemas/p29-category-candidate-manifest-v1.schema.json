{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_ref",
    "profile_family",
    "profile_version",
    "profile_kind",
    "response_count",
    "input_candidate_rows",
    "deduplicated_candidate_rows",
    "product_count",
    "sku_count",
    "category_count",
    "deduplication",
    "record_kind",
    "record_count",
    "coverage_status",
    "coverage_scope",
    "can_publish_complete_result",
    "cross_observation_fields_copied",
    "raw_payload_persisted",
    "sensitive_values_processed",
    "unknown_facts",
    "sources",
    "result_name",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "p29-category-candidate-manifest/v1"
    },
    "window_ref": {
      "type": "string",
      "pattern": "^result:[a-f0-9]{32}$"
    },
    "profile_family": {
      "const": "meituan_wechat_miniprogram"
    },
    "profile_version": {
      "const": "p29-observed-category-render-v1"
    },
    "profile_kind": {
      "const": "LOCAL_OBSERVED_CANDIDATE_RULES"
    },
    "response_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "input_candidate_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "deduplicated_candidate_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "product_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "sku_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "category_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "deduplication": {
      "const": "LATEST_OWN_CANDIDATE_PER_SKU_CATEGORY"
    },
    "record_kind": {
      "const": "PARTIAL_CATEGORY_CANDIDATE"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40000
    },
    "coverage_status": {
      "const": "PARTIAL"
    },
    "coverage_scope": {
      "const": "OBSERVED_MATCHED_CATEGORY_RESPONSES_ONLY"
    },
    "can_publish_complete_result": {
      "const": false
    },
    "cross_observation_fields_copied": {
      "const": false
    },
    "raw_payload_persisted": {
      "const": false
    },
    "sensitive_values_processed": {
      "const": false
    },
    "unknown_facts": {
      "const": [
        "MERCHANT_NAME_IN_RESPONSE",
        "CATEGORY_NAME_IN_RESPONSE",
        "PRICE_CURRENCY_AND_UNIT",
        "PRICE_SEMANTICS",
        "CATEGORY_TERMINATION",
        "TAG_TYPE_SEMANTICS",
        "CHILD_TAG_SEMANTICS"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file",
          "source_request_ref",
          "observed_at",
          "source_context_result_name",
          "source_context_observed_at",
          "source_context_age_within_10_seconds",
          "batch_parameter_file",
          "array_item_relation"
        ],
        "properties": {
          "source_file": {
            "type": "string",
            "pattern": "^category_render_[a-f0-9]{32}-public-fields\\.json$"
          },
          "source_request_ref": {
            "type": "string",
            "pattern": "^request:[a-f0-9]{32}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_context_result_name": {
            "type": "string",
            "pattern": "^observation_[a-f0-9]{32}$"
          },
          "source_context_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_context_age_within_10_seconds": {
            "type": "boolean"
          },
          "batch_parameter_file": {
            "type": "string",
            "pattern": "^category_render_[a-f0-9]{32}-batch-parameter\\.json$"
          },
          "array_item_relation": {
            "const": "MATCHED_CURRENT_RESPONSE"
          }
        }
      }
    },
    "result_name": {
      "type": "string",
      "pattern": "^category_candidates_[a-f0-9]{32}$"
    },
    "files": {
      "const": [
        "records.json",
        "records.csv",
        "manifest.json"
      ]
    }
  }
}
