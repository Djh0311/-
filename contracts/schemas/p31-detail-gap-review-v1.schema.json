{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P31 store-detail gap review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery",
    "field_dictionary",
    "path_disposition",
    "coverage",
    "manifest"
  ],
  "properties": {
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_count",
        "opening_hours_filled_from_delivery_period",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": "p31-detail-delivery-scalars/v1"
        },
        "record_count": {
          "const": 1
        },
        "opening_hours_filled_from_delivery_period": {
          "const": false
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "store_id",
              "store_numeric_id",
              "source_file",
              "observed_at",
              "window_ref",
              "delivery_service_text",
              "delivery_info_type_text",
              "delivery_type_code",
              "distance_text",
              "map_display_range_number",
              "map_type_code"
            ],
            "properties": {
              "store_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "store_numeric_id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^-?(0|[1-9][0-9]*)$"
              },
              "source_file": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^store_detail_[a-f0-9]{32}-public-fields\\.json$"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "window_ref": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^result:[a-f0-9]{32}$"
              },
              "delivery_service_text": {
                "$ref": "#/$defs/textFact"
              },
              "delivery_info_type_text": {
                "$ref": "#/$defs/textFact"
              },
              "delivery_type_code": {
                "$ref": "#/$defs/numberFact"
              },
              "distance_text": {
                "$ref": "#/$defs/textFact"
              },
              "map_display_range_number": {
                "$ref": "#/$defs/numberFact"
              },
              "map_type_code": {
                "$ref": "#/$defs/numberFact"
              }
            }
          }
        }
      }
    },
    "field_dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fields"
      ],
      "properties": {
        "schema_version": {
          "const": "p31-detail-delivery-dictionary/v1"
        },
        "fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "label_zh",
              "source_path",
              "kind"
            ],
            "properties": {
              "field": {
                "enum": [
                  "delivery_service_text",
                  "delivery_info_type_text",
                  "delivery_type_code",
                  "distance_text",
                  "map_display_range_number",
                  "map_type_code"
                ]
              },
              "label_zh": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "source_path": {
                "type": "string",
                "maxLength": 512
              },
              "kind": {
                "enum": [
                  "TEXT",
                  "INTEGER"
                ]
              }
            }
          }
        }
      }
    },
    "path_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "business_values_included",
        "paths",
        "counts"
      ],
      "properties": {
        "schema_version": {
          "const": "p31-detail-path-disposition/v1"
        },
        "business_values_included": {
          "const": false
        },
        "paths": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/pathRow"
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fields",
        "gaps",
        "images",
        "personal_offers",
        "store_coordinates_exported",
        "unclassified_count",
        "product_result"
      ],
      "properties": {
        "schema_version": {
          "const": "p31-detail-gap-coverage/v1"
        },
        "fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "state"
            ],
            "properties": {
              "field": {
                "enum": [
                  "delivery_service_text",
                  "delivery_info_type_text",
                  "delivery_type_code",
                  "distance_text",
                  "map_display_range_number",
                  "map_type_code"
                ]
              },
              "state": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "images": {
          "const": "EXCLUDED_BY_USER"
        },
        "personal_offers": {
          "const": "EXCLUDED_BY_USER"
        },
        "store_coordinates_exported": {
          "const": false
        },
        "unclassified_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "product_result": {
          "const": "incomplete"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_name",
        "record_count",
        "files",
        "detail_file",
        "path_count",
        "unclassified_count",
        "live_attempts_consumed",
        "raw_payload_read",
        "original_files_modified",
        "product_result"
      ],
      "properties": {
        "schema_version": {
          "const": "p31-detail-gap-manifest/v1"
        },
        "result_name": {
          "type": "string",
          "pattern": "^p31_detail_gap_[a-f0-9]{32}$"
        },
        "record_count": {
          "const": 1
        },
        "files": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "enum": [
              "delivery.json",
              "delivery.csv",
              "field_dictionary.json",
              "path_disposition.json",
              "coverage.json",
              "manifest.json"
            ]
          }
        },
        "detail_file": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^store_detail_[a-f0-9]{32}-public-fields\\.json$"
        },
        "path_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "unclassified_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "live_attempts_consumed": {
          "const": 0
        },
        "raw_payload_read": {
          "const": false
        },
        "original_files_modified": {
          "const": false
        },
        "product_result": {
          "const": "incomplete"
        }
      }
    }
  },
  "$defs": {
    "textFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "state"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "pattern": "^(?!.*://)[^\\r\\n\\u0000]*$"
        },
        "state": {
          "enum": [
            "PRESENT_AS_OBSERVED",
            "SOURCE_NULL",
            "SOURCE_EMPTY",
            "NOT_OBSERVED",
            "SOURCE_REJECTED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "SOURCE_NULL",
                  "NOT_OBSERVED",
                  "SOURCE_REJECTED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "SOURCE_EMPTY"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "PRESENT_AS_OBSERVED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "numberFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "state"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "state": {
          "enum": [
            "PRESENT_UNCONFIRMED",
            "NEGATIVE_SEMANTICS_UNCONFIRMED",
            "SOURCE_NULL",
            "NOT_OBSERVED",
            "SOURCE_REJECTED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "SOURCE_NULL",
                  "NOT_OBSERVED",
                  "SOURCE_REJECTED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "PRESENT_UNCONFIRMED",
                  "NEGATIVE_SEMANTICS_UNCONFIRMED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "pathRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "types",
        "value_count",
        "null_count",
        "empty_count",
        "text_count",
        "number_count",
        "boolean_count",
        "unavailable_reasons",
        "disposition"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])*)*$"
        },
        "types": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "value_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "null_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "empty_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "text_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "number_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "boolean_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8000
        },
        "unavailable_reasons": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": [
              "NONSCALAR",
              "STRING_LENGTH",
              "URL_VALUE",
              "LINE_BREAK",
              "NONFINITE_NUMBER"
            ]
          }
        },
        "disposition": {
          "enum": [
            "ENVELOPE",
            "ALREADY_EXPORTED",
            "CONTAINER",
            "DELIVERY_SCALAR_EXPORTED",
            "IMAGE_OR_URL_EXCLUDED",
            "IMAGE_GALLERY_EXCLUDED",
            "PRESENTATION_NOT_EXPORTED",
            "STORE_COORDINATE_NOT_EXPORTED",
            "PUBLIC_SCALAR_UNCONFIRMED_NOT_EXPORTED",
            "OBJECT_WITHOUT_PUBLIC_SCALARS",
            "UNCLASSIFIED"
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ENVELOPE",
        "ALREADY_EXPORTED",
        "CONTAINER",
        "DELIVERY_SCALAR_EXPORTED",
        "IMAGE_OR_URL_EXCLUDED",
        "IMAGE_GALLERY_EXCLUDED",
        "PRESENTATION_NOT_EXPORTED",
        "STORE_COORDINATE_NOT_EXPORTED",
        "PUBLIC_SCALAR_UNCONFIRMED_NOT_EXPORTED",
        "OBJECT_WITHOUT_PUBLIC_SCALARS",
        "UNCLASSIFIED"
      ],
      "properties": {
        "ENVELOPE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "ALREADY_EXPORTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "CONTAINER": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "DELIVERY_SCALAR_EXPORTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "IMAGE_OR_URL_EXCLUDED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "IMAGE_GALLERY_EXCLUDED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "PRESENTATION_NOT_EXPORTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "STORE_COORDINATE_NOT_EXPORTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "PUBLIC_SCALAR_UNCONFIRMED_NOT_EXPORTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "OBJECT_WITHOUT_PUBLIC_SCALARS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "UNCLASSIFIED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "status",
        "matched_path_count",
        "explanation_zh"
      ],
      "properties": {
        "field": {
          "enum": [
            "opening_hours",
            "complete_promotion_rules",
            "complete_delivery_rules",
            "remaining_public_fields"
          ]
        },
        "status": {
          "enum": [
            "PATH_ABSENT",
            "OBSERVED_NOT_EXPORTED",
            "PARTIAL_SOURCE_SCALARS",
            "CLASSIFIED_NOT_FULLY_EXPORTED"
          ]
        },
        "matched_path_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "explanation_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "enum": [
                  "opening_hours",
                  "complete_promotion_rules"
                ]
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "PATH_ABSENT",
                  "OBSERVED_NOT_EXPORTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "complete_delivery_rules"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "PARTIAL_SOURCE_SCALARS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "remaining_public_fields"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "CLASSIFIED_NOT_FULLY_EXPORTED"
              }
            }
          }
        }
      ]
    }
  }
}
