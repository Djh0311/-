{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {"$ref": "#/$defs/metadata"},
    {
      "required": ["schema_version", "records"],
      "properties": {
        "schema_version": {"const": "p29-store-input-inventory/v2"},
        "records": {"type": "array", "minItems": 1, "maxItems": 40000, "items": {"$ref": "#/$defs/record"}}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "text": {"type": "string", "maxLength": 256, "pattern": "^[^\r\n\u0000]*$"},
    "optional_text": {"type": ["string", "null"], "maxLength": 256, "pattern": "^[^\r\n\u0000]*$"},
    "number": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "optional_number": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
    "id": {"type": "string", "pattern": "^-?[0-9]{1,64}$"},
    "request": {"type": "string", "pattern": "^request:[a-f0-9]{32}$"},
    "source_file": {"type": "string", "pattern": "^(?:observation|category_render)_[a-f0-9]{32}-public-fields\\.json$"},
    "initial_file": {"type": "string", "pattern": "^observation_[a-f0-9]{32}-public-fields\\.json$"},
    "window": {"type": "string", "pattern": "^result:[a-f0-9]{32}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 40000},
    "state": {"enum": ["NOT_OBSERVED", "SOURCE_EMPTY", "PRESENT"]},
    "metadata": {
      "type": "object",
      "required": [
        "window_ref", "record_count", "input_record_count", "deduplicated_record_count",
        "product_count", "sku_count", "category_count", "checked_initial_rows", "partial_category_rows",
        "coverage_status", "coverage_scope", "deduplication", "price_meaning", "category_labels",
        "cross_observation_prices_or_specs_copied", "complete_result_promotion",
        "currency_inferred", "category_currency_borrowed_from_initial_pair",
        "raw_payload_persisted", "sensitive_values_processed", "categories"
      ],
      "properties": {
        "window_ref": {"$ref": "#/$defs/window"},
        "record_count": {"type": "integer", "minimum": 1, "maximum": 40000},
        "input_record_count": {"$ref": "#/$defs/count"},
        "deduplicated_record_count": {"$ref": "#/$defs/count"},
        "product_count": {"$ref": "#/$defs/count"},
        "sku_count": {"$ref": "#/$defs/count"},
        "category_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "checked_initial_rows": {"$ref": "#/$defs/count"},
        "partial_category_rows": {"$ref": "#/$defs/count"},
        "coverage_status": {"const": "PARTIAL"},
        "coverage_scope": {"const": "CURRENT_WINDOW_OBSERVED_PUBLIC_INPUT"},
        "deduplication": {"const": "LATEST_WHOLE_OWN_ROW_PER_CATEGORY_SKU"},
        "price_meaning": {"const": "OWN_RESPONSE_PRICE_NUMBERS_CURRENCY_NOT_INFERRED"},
        "category_labels": {"const": "REFERENCES_WITH_EXPLICIT_SOURCE_NOT_RESPONSE_OWNED_FIELDS"},
        "cross_observation_prices_or_specs_copied": {"const": false},
        "complete_result_promotion": {"const": false},
        "currency_inferred": {"const": false},
        "category_currency_borrowed_from_initial_pair": {"const": false},
        "raw_payload_persisted": {"const": false},
        "sensitive_values_processed": {"const": false},
        "categories": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["category_ref", "category_reference_label", "source_index", "source_file", "source_request_ref", "observed_at", "label_kind"],
            "properties": {
              "category_ref": {"allOf": [{"$ref": "#/$defs/text"}, {"minLength": 1}]},
              "category_reference_label": {"allOf": [{"$ref": "#/$defs/text"}, {"minLength": 1}]},
              "source_index": {"type": "integer", "minimum": 0, "maximum": 255},
              "source_file": {"$ref": "#/$defs/initial_file"},
              "source_request_ref": {"$ref": "#/$defs/request"},
              "observed_at": {"type": "string", "format": "date-time"},
              "label_kind": {"const": "REFERENCED_INITIAL_LIST_LABEL"}
            }
          }
        }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": [
        "category_reference_label", "product_name", "sku_spec", "sku_price_number",
        "product_min_price_number", "sku_origin_number", "product_unit", "sku_description",
        "currency", "amount_unit", "currency_status", "amount_unit_status",
        "currency_basis", "amount_unit_basis", "sku_price_source", "numeric_min_relation",
        "product_unit_role", "render_origin_number", "render_origin_state",
        "product_full_discount_price_number", "product_full_discount_price_state",
        "sku_member_price_number", "sku_member_price_state",
        "sku_full_discount_price_number", "sku_full_discount_price_state",
        "sku_box_price_number", "sku_box_price_state",
        "min_price_tail", "min_price_tail_state",
        "render_price_desc", "render_price_desc_state",
        "sku_price_desc", "sku_price_desc_state",
        "source_kind", "category_ref", "product_id", "sku_id",
        "sku_spec_state", "sku_description_state", "product_unit_state",
        "source_file", "source_request_ref", "observed_at",
        "category_label_source_file", "category_label_source_request_ref",
        "category_label_observed_at", "window_ref"
      ],
      "properties": {
        "category_reference_label": {"allOf": [{"$ref": "#/$defs/text"}, {"minLength": 1}]},
        "product_name": {"allOf": [{"$ref": "#/$defs/text"}, {"minLength": 1}]},
        "sku_spec": {"$ref": "#/$defs/optional_text"},
        "sku_description": {"$ref": "#/$defs/optional_text"},
        "product_unit": {"$ref": "#/$defs/optional_text"},
        "sku_price_number": {"$ref": "#/$defs/number"},
        "product_min_price_number": {"$ref": "#/$defs/number"},
        "sku_origin_number": {"$ref": "#/$defs/optional_number"},
        "currency": {"anyOf": [{"const": "CNY"}, {"type": "null"}]},
        "amount_unit": {"anyOf": [{"const": "YUAN"}, {"type": "null"}]},
        "currency_status": {"type": "string"},
        "amount_unit_status": {"type": "string"},
        "currency_basis": {"type": "string"},
        "amount_unit_basis": {"type": "string"},
        "sku_price_source": {"type": "string"},
        "numeric_min_relation": {"type": "string"},
        "product_unit_role": {"type": "string"},
        "render_origin_number": {"$ref": "#/$defs/optional_number"},
        "render_origin_state": {"type": "string"},
        "product_full_discount_price_number": {"$ref": "#/$defs/optional_number"},
        "product_full_discount_price_state": {"type": "string"},
        "sku_member_price_number": {"$ref": "#/$defs/optional_number"},
        "sku_member_price_state": {"type": "string"},
        "sku_full_discount_price_number": {"$ref": "#/$defs/optional_number"},
        "sku_full_discount_price_state": {"type": "string"},
        "sku_box_price_number": {"$ref": "#/$defs/optional_number"},
        "sku_box_price_state": {"type": "string"},
        "min_price_tail": {"$ref": "#/$defs/optional_text"},
        "min_price_tail_state": {"type": "string"},
        "render_price_desc": {"$ref": "#/$defs/optional_text"},
        "render_price_desc_state": {"type": "string"},
        "sku_price_desc": {"$ref": "#/$defs/optional_text"},
        "sku_price_desc_state": {"type": "string"},
        "source_kind": {"enum": ["CHECKED_INITIAL_PAIR", "PARTIAL_CATEGORY_CANDIDATE"]},
        "category_ref": {"allOf": [{"$ref": "#/$defs/text"}, {"minLength": 1}]},
        "product_id": {"$ref": "#/$defs/id"},
        "sku_id": {"$ref": "#/$defs/id"},
        "sku_spec_state": {"$ref": "#/$defs/state"},
        "sku_description_state": {"$ref": "#/$defs/state"},
        "product_unit_state": {"$ref": "#/$defs/state"},
        "source_file": {"$ref": "#/$defs/source_file"},
        "source_request_ref": {"$ref": "#/$defs/request"},
        "observed_at": {"type": "string", "format": "date-time"},
        "category_label_source_file": {"$ref": "#/$defs/initial_file"},
        "category_label_source_request_ref": {"$ref": "#/$defs/request"},
        "category_label_observed_at": {"type": "string", "format": "date-time"},
        "window_ref": {"$ref": "#/$defs/window"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "CHECKED_INITIAL_PAIR"}}, "required": ["source_kind"]},
          "then": {
            "properties": {
              "currency": {"const": "CNY"},
              "amount_unit": {"const": "YUAN"},
              "currency_status": {"const": "PAGE_CONFIRMED_FOR_INITIAL_PAIR_ONLY"},
              "amount_unit_status": {"const": "PAGE_CONFIRMED_FOR_INITIAL_PAIR_ONLY"},
              "currency_basis": {"const": "INITIAL_PAIR_PAGE_CONFIRMATION"},
              "amount_unit_basis": {"const": "INITIAL_PAIR_PAGE_CONFIRMATION"},
              "sku_price_source": {"const": "INITIAL_PAIR_PAGE_CONFIRMED_SKU_PRICE"},
              "numeric_min_relation": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "product_unit_role": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "source_file": {"$ref": "#/$defs/initial_file"},
              "render_origin_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "product_full_discount_price_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "sku_member_price_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "sku_full_discount_price_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "sku_box_price_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "min_price_tail_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "render_price_desc_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"},
              "sku_price_desc_state": {"const": "NOT_REPARSED_ON_INITIAL_PAIR"}
            }
          },
          "else": {
            "properties": {
              "currency": {"type": "null"},
              "amount_unit": {"type": "null"},
              "currency_status": {"enum": ["NOT_PROVIDED_IN_OBSERVED_PUBLIC_STRUCTURE", "PRESENT_PATH_NOT_ADAPTED"]},
              "amount_unit_status": {"enum": ["NOT_PROVIDED_IN_OBSERVED_PUBLIC_STRUCTURE", "PRESENT_PATH_NOT_ADAPTED"]},
              "currency_basis": {"const": "NOT_BORROWED_FROM_INITIAL_PAIR"},
              "amount_unit_basis": {"const": "NOT_BORROWED_FROM_INITIAL_PAIR"},
              "sku_price_source": {"const": "SAME_RESPONSE_SKU_PRICE_SCALAR"},
              "numeric_min_relation": {"const": "EQUAL_PRODUCT_RENDER_AND_MIN_SKU"},
              "product_unit_role": {"enum": ["NOT_OBSERVED", "SOURCE_EMPTY", "PRODUCT_MEASURE_TEXT_NOT_AMOUNT_UNIT", "CLOSED_MARK_NOT_PROMOTED_TO_CURRENCY_OR_AMOUNT_UNIT"]},
              "source_file": {"pattern": "^category_render_[a-f0-9]{32}-public-fields\\.json$"},
              "render_origin_state": {"enum": ["NOT_OBSERVED", "PRESENT_SEMANTICS_UNCONFIRMED", "PRESENT_NEGATIVE_NUMBER_NOT_ADAPTED_AS_AMOUNT"]},
              "product_full_discount_price_state": {"enum": ["NOT_OBSERVED", "PRESENT_SEMANTICS_UNCONFIRMED", "PRESENT_NEGATIVE_NUMBER_NOT_ADAPTED_AS_AMOUNT"]},
              "sku_member_price_state": {"enum": ["NOT_OBSERVED", "PRESENT_SEMANTICS_UNCONFIRMED", "PRESENT_NEGATIVE_NUMBER_NOT_ADAPTED_AS_AMOUNT"]},
              "sku_full_discount_price_state": {"enum": ["NOT_OBSERVED", "PRESENT_SEMANTICS_UNCONFIRMED", "PRESENT_NEGATIVE_NUMBER_NOT_ADAPTED_AS_AMOUNT"]},
              "sku_box_price_state": {"enum": ["NOT_OBSERVED", "PRESENT_SEMANTICS_UNCONFIRMED", "PRESENT_NEGATIVE_NUMBER_NOT_ADAPTED_AS_AMOUNT"]},
              "min_price_tail_state": {"enum": ["NOT_OBSERVED", "SOURCE_EMPTY", "PRESENT_TEXT_NOT_CURRENCY_OR_AMOUNT_UNIT", "CLOSED_MARK_NOT_PROMOTED_TO_CURRENCY_OR_AMOUNT_UNIT"]},
              "render_price_desc_state": {"enum": ["NOT_OBSERVED", "SOURCE_EMPTY", "PRESENT_TEXT_NOT_CURRENCY_OR_AMOUNT_UNIT", "CLOSED_MARK_NOT_PROMOTED_TO_CURRENCY_OR_AMOUNT_UNIT"]},
              "sku_price_desc_state": {"enum": ["NOT_OBSERVED", "SOURCE_EMPTY", "PRESENT_TEXT_NOT_CURRENCY_OR_AMOUNT_UNIT", "CLOSED_MARK_NOT_PROMOTED_TO_CURRENCY_OR_AMOUNT_UNIT"]}
            }
          }
        }
      ]
    }
  }
}
