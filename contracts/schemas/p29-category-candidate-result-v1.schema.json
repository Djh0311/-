{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_ref",
    "profile_family",
    "profile_version",
    "profile_kind",
    "response_count",
    "input_candidate_rows",
    "deduplicated_candidate_rows",
    "product_count",
    "sku_count",
    "category_count",
    "deduplication",
    "record_kind",
    "record_count",
    "coverage_status",
    "coverage_scope",
    "can_publish_complete_result",
    "cross_observation_fields_copied",
    "raw_payload_persisted",
    "sensitive_values_processed",
    "unknown_facts",
    "sources",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "p29-category-candidate-result/v1"
    },
    "window_ref": {
      "type": "string",
      "pattern": "^result:[a-f0-9]{32}$"
    },
    "profile_family": {
      "const": "meituan_wechat_miniprogram"
    },
    "profile_version": {
      "const": "p29-observed-category-render-v1"
    },
    "profile_kind": {
      "const": "LOCAL_OBSERVED_CANDIDATE_RULES"
    },
    "response_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "input_candidate_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "deduplicated_candidate_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "product_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "sku_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40000
    },
    "category_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "deduplication": {
      "const": "LATEST_OWN_CANDIDATE_PER_SKU_CATEGORY"
    },
    "record_kind": {
      "const": "PARTIAL_CATEGORY_CANDIDATE"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40000
    },
    "coverage_status": {
      "const": "PARTIAL"
    },
    "coverage_scope": {
      "const": "OBSERVED_MATCHED_CATEGORY_RESPONSES_ONLY"
    },
    "can_publish_complete_result": {
      "const": false
    },
    "cross_observation_fields_copied": {
      "const": false
    },
    "raw_payload_persisted": {
      "const": false
    },
    "sensitive_values_processed": {
      "const": false
    },
    "unknown_facts": {
      "const": [
        "MERCHANT_NAME_IN_RESPONSE",
        "CATEGORY_NAME_IN_RESPONSE",
        "PRICE_CURRENCY_AND_UNIT",
        "PRICE_SEMANTICS",
        "CATEGORY_TERMINATION",
        "TAG_TYPE_SEMANTICS",
        "CHILD_TAG_SEMANTICS"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file",
          "source_request_ref",
          "observed_at",
          "source_context_result_name",
          "source_context_observed_at",
          "source_context_age_within_10_seconds",
          "batch_parameter_file",
          "array_item_relation"
        ],
        "properties": {
          "source_file": {
            "type": "string",
            "pattern": "^category_render_[a-f0-9]{32}-public-fields\\.json$"
          },
          "source_request_ref": {
            "type": "string",
            "pattern": "^request:[a-f0-9]{32}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_context_result_name": {
            "type": "string",
            "pattern": "^observation_[a-f0-9]{32}$"
          },
          "source_context_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_context_age_within_10_seconds": {
            "type": "boolean"
          },
          "batch_parameter_file": {
            "type": "string",
            "pattern": "^category_render_[a-f0-9]{32}-batch-parameter\\.json$"
          },
          "array_item_relation": {
            "const": "MATCHED_CURRENT_RESPONSE"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_ref",
          "product_id",
          "product_name",
          "sku_id",
          "product_min_price_number",
          "render_min_price_number",
          "sku_price_number",
          "product_unit",
          "product_unit_state",
          "sku_spec",
          "sku_spec_state",
          "sku_description",
          "sku_description_state",
          "sku_origin_number",
          "sku_origin_number_state",
          "currency",
          "amount_unit",
          "price_meaning",
          "store_scope",
          "store_name_state",
          "category_name_state",
          "source_file",
          "source_request_ref",
          "observed_at",
          "window_ref"
        ],
        "properties": {
          "category_ref": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\u0000]*$",
            "minLength": 1
          },
          "product_id": {
            "type": "string",
            "pattern": "^-?[0-9]{1,64}$"
          },
          "product_name": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\u0000]*$",
            "minLength": 1
          },
          "sku_id": {
            "type": "string",
            "pattern": "^-?[0-9]{1,64}$"
          },
          "product_min_price_number": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "render_min_price_number": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "sku_price_number": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "product_unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\u0000]*$"
          },
          "product_unit_state": {
            "enum": [
              "NOT_OBSERVED",
              "SOURCE_EMPTY",
              "PRESENT"
            ]
          },
          "sku_spec": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\u0000]*$"
          },
          "sku_spec_state": {
            "enum": [
              "NOT_OBSERVED",
              "SOURCE_EMPTY",
              "PRESENT"
            ]
          },
          "sku_description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\u0000]*$"
          },
          "sku_description_state": {
            "enum": [
              "NOT_OBSERVED",
              "SOURCE_EMPTY",
              "PRESENT"
            ]
          },
          "sku_origin_number": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          },
          "sku_origin_number_state": {
            "enum": [
              "NOT_OBSERVED",
              "SEMANTICS_UNCONFIRMED"
            ]
          },
          "currency": {
            "const": "UNKNOWN"
          },
          "amount_unit": {
            "const": "UNKNOWN"
          },
          "price_meaning": {
            "const": "UNCONFIRMED_CATEGORY_SOURCE_NUMBERS"
          },
          "store_scope": {
            "const": "MATCHED_CURRENT_STORE_REQUEST"
          },
          "store_name_state": {
            "const": "NOT_OBSERVED_IN_RESPONSE"
          },
          "category_name_state": {
            "const": "NOT_OBSERVED_IN_RESPONSE"
          },
          "source_file": {
            "type": "string",
            "pattern": "^category_render_[a-f0-9]{32}-public-fields\\.json$"
          },
          "source_request_ref": {
            "type": "string",
            "pattern": "^request:[a-f0-9]{32}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "window_ref": {
            "type": "string",
            "pattern": "^result:[a-f0-9]{32}$"
          }
        }
      }
    }
  }
}
